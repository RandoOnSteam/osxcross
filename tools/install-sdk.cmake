cmake_minimum_required(VERSION 3.20)

if(NOT SDK)
  message(FATAL_ERROR "Usage: cmake -DSDK=<path to MacOSX<version>.sdk.tar.xz> -P install-sdk.cmake")
endif()

set(root "${CMAKE_CURRENT_LIST_DIR}")
get_filename_component(sdkarchive "${SDK}" ABSOLUTE)
get_filename_component(sdkname "${sdkarchive}" NAME)
if(NOT sdkname MATCHES "^MacOSX([0-9.]+)\\.sdk\\.")
  message(FATAL_ERROR "${sdkname} is not named MacOSX<version>.sdk.<extension>")
endif()
set(version "${CMAKE_MATCH_1}")
if(NOT IS_DIRECTORY "${root}/${version}/bin")
  file(GLOB toolchains RELATIVE "${root}" "${root}/*/bin")
  message(FATAL_ERROR "No toolchain for SDK ${version} in this package. Available: ${toolchains}")
endif()

function(ResolveLinks path result)
  file(RELATIVE_PATH relative "${sdksource}" "${path}")
  string(REPLACE "/" ";" parts "${relative}")
  set(current "${sdksource}")
  set(followed 0)
  while(parts)
    list(POP_FRONT parts part)
    if(part STREQUAL "" OR part STREQUAL ".")
      continue()
    endif()
    if(part STREQUAL "..")
      get_filename_component(current "${current}" DIRECTORY)
      continue()
    endif()
    set(candidate "${current}/${part}")
    if(IS_SYMLINK "${candidate}")
      math(EXPR followed "${followed} + 1")
      file(READ_SYMLINK "${candidate}" link)
      if(followed GREATER 64 OR IS_ABSOLUTE "${link}")
        set(${result} "" PARENT_SCOPE)
        return()
      endif()
      string(REPLACE "/" ";" linkparts "${link}")
      list(PREPEND parts ${linkparts})
    else()
      set(current "${candidate}")
    endif()
  endwhile()
  if(EXISTS "${current}")
    set(${result} "${current}" PARENT_SCOPE)
  else()
    set(${result} "" PARENT_SCOPE)
  endif()
endfunction()

function(CopyResolved source destination active)
  file(MAKE_DIRECTORY "${destination}")
  file(GLOB entries LIST_DIRECTORIES true "${source}/*")
  foreach(entry IN LISTS entries)
    get_filename_component(name "${entry}" NAME)
    if(name MATCHES "[<>:\"|?*]")
      continue()
    endif()
    ResolveLinks("${entry}" resolved)
    if(resolved STREQUAL "")
      continue()
    endif()
    if(IS_DIRECTORY "${resolved}")
      if(NOT resolved IN_LIST active)
        set(nested ${active} "${resolved}")
        CopyResolved("${resolved}" "${destination}/${name}" "${nested}")
      endif()
    else()
      file(COPY_FILE "${resolved}" "${destination}/${name}")
    endif()
  endforeach()
endfunction()

set(sdkroot "${root}/${version}/SDK")
set(extract "${sdkroot}/.extract")
set(destination "${sdkroot}/MacOSX${version}.sdk")
file(REMOVE_RECURSE "${extract}" "${destination}")
file(MAKE_DIRECTORY "${extract}")

message(STATUS "Extracting ${sdkname}")
execute_process(
  COMMAND tar -xf "${sdkarchive}" --exclude "*/usr/share/man/*" -C "${extract}"
  RESULT_VARIABLE result)
file(GLOB extracted LIST_DIRECTORIES true "${extract}/MacOSX${version}*.sdk" "${extract}/SDKs/MacOSX${version}*.sdk")
list(LENGTH extracted count)
if(NOT count EQUAL 1)
  message(FATAL_ERROR "tar failed (${result}) or ${sdkname} does not contain MacOSX${version}.sdk")
endif()

message(STATUS "Installing MacOSX${version}.sdk")
set(sdksource "${extracted}")
CopyResolved("${extracted}" "${destination}" "${extracted}")
file(REMOVE_RECURSE "${extract}")

file(REMOVE "${destination}/usr/include/c++/v1/libcxx.imp")
file(GLOB quirks "${root}/share/osxcross/quirks/*.h")
foreach(quirk IN LISTS quirks)
  get_filename_component(name "${quirk}" NAME)
  if(NOT EXISTS "${destination}/usr/include/${name}")
    file(COPY_FILE "${quirk}" "${destination}/usr/include/${name}")
  endif()
endforeach()

message(STATUS "SDK ${version} installed to ${destination}")
